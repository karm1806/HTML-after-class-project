<html>
<head>
    <title>Animal Fact File</title>
    <style>
        body{
            background-color: darkgreen;
            font-family: Arial, Helvetica, sans-serif;
        }
        .fact-file{
            background-color: lightyellow;
            color: darkslategrey;
            width: 260px;
            padding: 300px;
            border: 4px solid forestgreen;
            margin: 40px;
        }
        .animal-name{
            color: forestgreen;
            font-size: 22px;
        }
        .detail{
            color: darkslategrey;
        }
        .cool-fact{
            color: darkorange;
            font-style: italic;
        }
        </style>
</head>
<body>
    <div class="fact-file">
        <h2 class="animal-name">Snow Leopard</h2>
        <p class="detail">Type: Big Cat</p>
        <p class="detail">Lives in: Mountain ranges of Central Asia</p>
        <p class="detail">Diet: Deer, goats, and wild sheeps</p>
        <p class="cool-fact">Cool fact: Can leap up to 15 metres in one jump!</p>
    </div>
</body>
</html>